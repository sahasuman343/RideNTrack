{
  "name": "ridentrack-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "mobile",
    "web"
  ],
  "scripts": {
    "mobile": "npm --workspace=mobile run start",
    "web": "npm --workspace=web run dev",
    "lint": "npm --workspace=web run lint",
    "test": "node --test tests/regression.cjs",
    "typecheck": "tsc --project mobile/tsconfig.json --noEmit && tsc --project web/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/react": "^19.0.8",
    "typescript": "^5.7.3"
  }
}
