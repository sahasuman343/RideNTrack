{
  "expo": {
    "name": "RideNTrack",
    "slug": "ridentrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/RnT_logo.png",
    "userInterfaceStyle": "dark",
    "scheme": "ridentrack",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RideNTrack needs your location to share it with your ride group even when the screen is locked.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@rnmapbox/maps",
      [
        "expo-notifications",
        {
          "color": "#FF6B00",
          "defaultChannel": "ride-alerts",
          "sounds": [
            "./assets/sounds/alert_chime.wav"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "RideNTrack uses the microphone only while you hold the talk button, to send a voice note to your ride group."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "RideNTrack uses motion sensors during a ride to notice a possible crash and ask if you are OK."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ridentrack.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationWhenInUseUsageDescription": "RideNTrack needs your location to show you on the ride map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RideNTrack needs your location to share it with your ride group even when the app is in the background or device is mounted in a tank bag.",
        "NSLocationAlwaysUsageDescription": "RideNTrack continuously tracks your group ride location in the background."
      }
    },
    "android": {
      "package": "com.ridentrack.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e",
        "foregroundImage": "./assets/RnT_logo.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/RnT_logo.png",
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91502983-9cb8-45db-b01a-f1c296405a2c"
      }
    },
    "owner": "sahasuman343",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/91502983-9cb8-45db-b01a-f1c296405a2c",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
