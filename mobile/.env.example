# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mapbox
EXPO_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token

# Crash reporting (optional; leave empty to disable)
EXPO_PUBLIC_SENTRY_DSN=

# Show "Sign in with phone" once SMS codes are set up (docs/features/phone-login.md)
EXPO_PUBLIC_PHONE_LOGIN=false
