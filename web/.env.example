# Copy to web/.env.local for local dev. On Vercel, set these in
# Project > Settings > Environment Variables (see docs/web-deploy.md).
# All of these are public by design: they ship in the browser bundle.
# Never put the Supabase service_role key or a Mapbox sk. token here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
NEXT_PUBLIC_MAPBOX_TOKEN=pk....

# Optional, for the marketing pages. Leave unset until you have the real value:
# pages show "not listed yet" or mark the policies as a draft instead.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_POLICY_DATE=
